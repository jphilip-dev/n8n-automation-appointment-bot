      "parameters": {
        "jsCode": "\nconst data = $input.first()?.json?.propertyName;\n\nlet session = {};\n\ntry {\n  session = typeof data === 'string'\n    ? JSON.parse(data)\n    : data || {};\n} catch {\n  session = {};\n}\n\nif (!session || typeof session !== 'object' || Array.isArray(session)) {\n  session = {};\n}\n\nreturn [{\n  json: session\n}];\n"
      },
