    {
      "parameters": {
        "jsCode": "const data = Object.values($input.first().json)[0];\n\nlet result = data ?? {};\n\ntry {\n  result = typeof data === 'string' ? JSON.parse(data) : result;\n} catch {\n  result = data;\n}\n\nreturn [\n  {\n    json: typeof result === 'object' && result !== null\n      ? result\n      : $input.first().json\n  }\n];"
      },
