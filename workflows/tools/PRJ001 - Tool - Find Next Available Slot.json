    {
      "parameters": {
        "jsCode": "\nconst config = $('Configuration').first().json;\n\nconst maxDays = $('SubFlow Trigger').first().json.max_days;\nconst timezone = config.timezone;\nconst workingDays = config.working_days;\n\n// Validate search range\nif (!Number.isInteger(maxDays) || maxDays < 1) {\n  throw new Error('max_days must be a positive integer.');\n}\n\n// Get today's date in the configured timezone\nconst today = new Intl.DateTimeFormat('en-CA', {\n  timeZone: timezone,\n  year: 'numeric',\n  month: '2-digit',\n  day: '2-digit'\n}).format(new Date());\n\nconst [year, month, day] = today.split('-').map(Number);\n\nconst dates = [];\n\n// Include today as day 1, up to maxDays total calendar days\nfor (let i = 0; i < maxDays; i++) {\n  const currentDate = new Date(\n    Date.UTC(year, month - 1, day + i)\n  );\n\n  // ISO weekday: Monday = 1, Sunday = 7\n  const dayOfWeek = currentDate.getUTCDay() || 7;\n\n  if (!workingDays.includes(dayOfWeek)) continue;\n\n  dates.push(currentDate.toISOString().slice(0, 10));\n}\n\nreturn dates.map(date => ({\n  json: {\n    date\n  }\n}));\n"
      },
