    {
      "parameters": {
        "jsCode": "const config = $('Configuration').first().json;\nconst appointmentType = config.appointment_type;\n\nconst selectedType = config.types.find(\n  type => type.name === appointmentType\n);\n\nif (!selectedType) {\n  return [{\n    json: {\n      valid: false,\n      error: 'Invalid appointment type.',\n      allowed_types: config.types.map(type => type.name)\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    valid: true,\n    appointment_type: selectedType.name,\n    duration_minutes: Number(selectedType.duration_minutes)\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
