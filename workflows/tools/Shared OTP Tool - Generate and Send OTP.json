    {
      "parameters": {
        "jsCode": "const hex = $input.first().json.data;\nconst value = parseInt(hex, 16);\n\nconst otp = 100000 + (value % 900000);\n\nconst existing = $('Convert to JSON').first().json;\nconst isResend = Object.keys(existing).length > 0;\n\nreturn [{\n  json: {\n    otp,\n    mismatch_count: 0,\n    resend_count: isResend\n      ? Number(existing.resend_count ?? 0) + 1\n      : 0\n  }\n}];"
      },
