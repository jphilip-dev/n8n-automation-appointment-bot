      "parameters": {
        "jsCode": "const events = $input.all();\n\nreturn events.map(item => {\n  const event = item.json;\n  const description = event.description || '';\n\n  const email = description.match(/^Email:\\s*(.*)$/m)?.[1] || '';\n  const customer = description.match(/^Customer:\\s*(.*)$/m)?.[1] || '';\n  const appointmentType = description.match(/^Appointment Type:\\s*(.*)$/m)?.[1] || '';\n\n  return {\n    json: {\n      event_id: event.id,\n      customer,\n      email,\n      appointment_type: appointmentType,\n      start_time: event.start?.dateTime || event.start?.date || null,\n      end_time: event.end?.dateTime || event.end?.date || null,\n      description\n    }\n  };\n});"
      },
