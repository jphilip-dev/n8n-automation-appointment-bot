    {
      "parameters": {
        "jsCode": "\nconst config = $('Configuration').first().json;\nconst dateCheck = $('Check Date').first().json;\n\nconst dateTime = $('SubFlow Trigger').first().json.date_time;\nconst duration = Number($input.first().json.duration_minutes);\n\nfunction invalid(error) {\n  return [{\n    json: {\n      valid: false,\n      error\n    }\n  }];\n}\n\n// Validate duration\nif (!Number.isFinite(duration) || duration <= 0) {\n  return invalid('Invalid appointment duration.');\n}\n\n// Validate start timestamp\nconst startTimestamp = Date.parse(dateTime);\n\nif (!Number.isFinite(startTimestamp)) {\n  return invalid('Invalid appointment date and time.');\n}\n\n// Get appointment start time in configured timezone\nconst [hour, minute] = dateCheck.local_time.split(':').map(Number);\n\nconst startMinutes = hour * 60 + minute;\nconst endMinutes = startMinutes + duration;\n\n// Check closing time\nconst closingMinutes = Number(config.closingHour) * 60;\n\nif (endMinutes > closingMinutes) {\n  return invalid('Appointment duration exceeds working hours.');\n}\n\n// Check lunch break overlap\nconst lunchStart = Number(config.lunch_start) * 60;\nconst lunchEnd = Number(config.lunch_end) * 60;\n\nif (\n  startMinutes < lunchEnd &&\n  endMinutes > lunchStart\n) {\n  return invalid('Appointment overlaps with the lunch break.');\n}\n\n// Calculate end timestamp\nconst endTimestamp = startTimestamp + duration * 60 * 1000;\n\n// Format timestamps in configured timezone with the correct UTC offset\nconst formatLocal = timestamp => {\n  const date = new Date(timestamp);\n\n  const localTime = date.toLocaleString('sv-SE', {\n    timeZone: config.timezone,\n    hour12: false\n  }).replace(' ', 'T');\n\n  const offset = new Intl.DateTimeFormat('en-US', {\n    timeZone: config.timezone,\n    timeZoneName: 'longOffset'\n  })\n    .formatToParts(date)\n    .find(part => part.type === 'timeZoneName')\n    .value\n    .replace('GMT', '');\n\n  return localTime + (offset === '' ? 'Z' : offset);\n};\n\nreturn [{\n  json: {\n    valid: true,\n    start_time: formatLocal(startTimestamp),\n    end_time: formatLocal(endTimestamp),\n    duration_minutes: duration\n  }\n}];\n"
      },
