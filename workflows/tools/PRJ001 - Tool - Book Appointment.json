    {
      "parameters": {
        "jsCode": "const config = $('Configuration').first().json;\nconst appointmentType = $('SubFlow Trigger').first().json.appointment_type;\n\nconst selectedType = config.types.find(\n  type => type.name === appointmentType\n);\n\nif (!selectedType) {\n  return [{\n    json: {\n      valid: false,\n      error: 'Invalid appointment type.',\n      allowed_types: config.types.map(type => type.name)\n    }\n  }];\n}\n\nconst duration = Number(selectedType.duration_minutes);\n\nif (!Number.isFinite(duration) || duration <= 0) {\n  return [{\n    json: {\n      valid: false,\n      error: 'Invalid appointment duration configured for this appointment type.'\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    valid: true,\n    appointment_type: selectedType.name,\n    duration_minutes: duration\n  }\n}];\n"
      },
